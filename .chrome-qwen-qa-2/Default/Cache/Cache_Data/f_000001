<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Codezzn Workbench</title>
  <style>
    :root{--bg:#09100e;--panel:#101916;--panel2:#15211d;--line:#25352f;--text:#ecf8f2;--muted:#8ba49a;--green:#42e69c;--green2:#1bb875;--danger:#ff6b75;--warn:#ffc857;--shadow:0 18px 60px #0007;--radius:14px}
    *{box-sizing:border-box}html,body{height:100%;margin:0}body{font:14px/1.5 Inter,ui-sans-serif,system-ui,"Microsoft YaHei",sans-serif;background:radial-gradient(circle at 80% -10%,#16483455,transparent 36%),var(--bg);color:var(--text);overflow:hidden}
    button,input,textarea,select{font:inherit}button{cursor:pointer}.app{height:100%;display:grid;grid-template-columns:230px 1fr}.sidebar{padding:22px 14px;border-right:1px solid var(--line);background:#0b1311dd;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:11px;padding:2px 10px 24px;font-size:20px;font-weight:800;letter-spacing:.3px}.logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--green),#177e57);display:grid;place-items:center;color:#062016;box-shadow:0 0 30px #42e69c33}.nav{display:grid;gap:4px}.nav button{border:0;background:transparent;color:var(--muted);text-align:left;padding:10px 12px;border-radius:10px;display:flex;align-items:center;gap:11px}.nav button:hover,.nav button.active{background:#1a2a24;color:var(--text)}.nav button.active{box-shadow:inset 3px 0 var(--green)}.icon{width:19px;text-align:center}.sidebar-foot{margin-top:auto;border-top:1px solid var(--line);padding:14px 8px 0;color:var(--muted);font-size:12px}.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);margin-right:6px}.main{min-width:0;display:flex;flex-direction:column}.topbar{height:66px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 26px;background:#0c1512aa;backdrop-filter:blur(12px)}.top-title{font-size:17px;font-weight:700}.top-actions{display:flex;gap:9px;align-items:center}.content{padding:25px;overflow:auto;height:calc(100vh - 66px)}.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:9px;padding:8px 13px}.btn:hover{border-color:#4c6d60}.btn.primary{color:#052117;background:var(--green);border-color:var(--green);font-weight:700}.btn.danger{color:#ffabb1;border-color:#6e3036}.btn.small{padding:5px 9px;font-size:12px}.grid{display:grid;grid-template-columns:repeat(4,minmax(160px,1fr));gap:14px}.card{background:linear-gradient(145deg,#121d19,#0f1815);border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:0 10px 35px #0002}.metric b{display:block;font-size:30px;margin:8px 0 2px}.metric span{color:var(--muted)}.hero{padding:26px;margin-bottom:18px;background:linear-gradient(110deg,#13251e,#10261c 50%,#173d2c);position:relative;overflow:hidden}.hero:after{content:"zzn";position:absolute;right:28px;top:-29px;font-size:110px;font-weight:900;color:#42e69c0c}.hero h1{font-size:28px;margin:0 0 7px}.hero p{margin:0;color:#a9beb6;max-width:680px}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 15px}.section-head h2{font-size:20px;margin:0}.section-head p{margin:4px 0 0;color:var(--muted)}.resource-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:13px}.resource{min-height:142px;display:flex;flex-direction:column}.resource-title{display:flex;gap:10px;align-items:center}.resource-title strong{font-size:15px}.badge{font-size:11px;padding:2px 7px;border-radius:10px;background:#1c4031;color:#87f4bf}.badge.off{background:#3b292b;color:#d8999e}.resource p{color:var(--muted);margin:10px 0}.resource-actions{display:flex;gap:7px;margin-top:auto}.empty{text-align:center;color:var(--muted);padding:55px 20px;border:1px dashed #30453d;border-radius:var(--radius)}
    .modal-wrap{position:fixed;inset:0;background:#0009;display:grid;place-items:center;padding:30px;z-index:20}.modal{width:min(720px,100%);max-height:90vh;overflow:auto;background:#101a17;border:1px solid #355047;border-radius:16px;box-shadow:var(--shadow)}.modal-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.modal-head h3{margin:0}.modal-body{padding:20px}.modal-foot{padding:15px 20px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:9px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{color:#a9bdb5;font-size:12px}.field input,.field textarea,.field select{width:100%;background:#0b1311;border:1px solid #2d4139;color:var(--text);border-radius:9px;padding:9px 10px;outline:0}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--green)}.field textarea{min-height:105px;resize:vertical}.checkrow{display:flex;gap:12px;flex-wrap:wrap}.check{display:flex;align-items:center;gap:6px;color:#bad0c7}.help{font-size:11px;color:var(--muted)}
    .chat-layout{height:calc(100vh - 116px);display:grid;grid-template-columns:240px 1fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#0d1613}.thread-pane{border-right:1px solid var(--line);padding:12px;overflow:auto}.thread{padding:10px;border-radius:9px;color:var(--muted);margin:3px 0}.thread:hover,.thread.active{background:#192822;color:var(--text)}.chat-main{display:flex;flex-direction:column;min-width:0}.messages{flex:1;padding:22px;overflow:auto}.message{display:flex;margin-bottom:18px}.message.user{justify-content:flex-end}.bubble{max-width:min(760px,82%);padding:12px 15px;border-radius:13px;background:#17241f;white-space:pre-wrap;word-break:break-word}.user .bubble{background:#245b43}.message-meta{font-size:11px;color:var(--muted);margin-bottom:4px}.composer{padding:15px;border-top:1px solid var(--line);display:grid;grid-template-columns:180px 1fr auto;gap:10px}.composer select,.composer textarea{background:#111d19;border:1px solid #30453d;color:var(--text);border-radius:10px;padding:10px}.composer textarea{resize:none;height:44px}.tool-event{font-size:12px;color:#9dc9b7;border-left:2px solid #33785b;padding-left:9px;margin:5px 0}.toast{position:fixed;right:24px;bottom:24px;background:#192822;border:1px solid #3a5b4e;padding:11px 15px;border-radius:10px;box-shadow:var(--shadow);z-index:40}.toast.error{border-color:#873d44;color:#ffb1b7}.codebox{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px}.run-trace{margin-top:14px}.trace-item{padding:10px;border-left:2px solid var(--green);margin:8px 0;background:#101c18}.hidden{display:none!important}@media(max-width:900px){.app{grid-template-columns:64px 1fr}.sidebar{padding:18px 8px}.brand span,.nav .label,.sidebar-foot{display:none}.brand{padding:0 6px 24px}.nav button{justify-content:center}.grid{grid-template-columns:1fr 1fr}.chat-layout{grid-template-columns:1fr}.thread-pane{display:none}.form-grid{grid-template-columns:1fr}.field.full{grid-column:1}.composer{grid-template-columns:1fr auto}.composer select{grid-column:1/-1}}
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="logo">Z</div><span>codezzn</span></div>
    <nav class="nav" id="nav"></nav>
    <div class="sidebar-foot"><span class="status-dot"></span><span id="healthText">正在连接</span><br>Agent Platform · v0.1</div>
  </aside>
  <main class="main">
    <header class="topbar"><div class="top-title" id="pageTitle">概览</div><div class="top-actions"><button class="btn small" onclick="openSettings()">⚙ API 密钥</button><button class="btn small" onclick="loadPage()">↻ 刷新</button></div></header>
    <section class="content" id="content"></section>
  </main>
</div>
<div id="modalRoot"></div><div id="toastRoot"></div>
<script>
const pages=[['dashboard','◫','概览'],['chat','◉','对话调试'],['agents','◆','智能体'],['providers','⬡','模型接入'],['skills','✦','技能'],['mcp_servers','⌁','MCP 服务'],['knowledge','▤','知识库'],['workflows','⑂','工作流']];
let state={page:'dashboard',cache:{},thread:null};
const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function headers(json=true){let h={};if(json)h['Content-Type']='application/json';let key=localStorage.codezznKey;if(key)h['X-Codezzn-Key']=key;return h}
async function api(path,opts={}){opts.headers={...headers(!(opts.body instanceof FormData)),...(opts.headers||{})};let r=await fetch(path,opts);let data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.detail||`HTTP ${r.status}`);return data}
function toast(msg,error=false){$('#toastRoot').innerHTML=`<div class="toast ${error?'error':''}">${esc(msg)}</div>`;setTimeout(()=>$('#toastRoot').innerHTML='',3200)}
function modal(title,body,onSave,wide=false){$('#modalRoot').innerHTML=`<div class="modal-wrap" onclick="if(event.target===this)closeModal()"><div class="modal" style="${wide?'width:min(920px,100%)':''}"><div class="modal-head"><h3>${esc(title)}</h3><button class="btn small" onclick="closeModal()">✕</button></div><div class="modal-body">${body}</div><div class="modal-foot"><button class="btn" onclick="closeModal()">取消</button>${onSave?`<button class="btn primary" id="modalSave">保存</button>`:''}</div></div></div>`;if(onSave)$('#modalSave').onclick=onSave}
function closeModal(){$('#modalRoot').innerHTML=''}
function field(label,name,value='',type='text',full=false,help=''){let input=type==='textarea'?`<textarea name="${name}">${esc(value)}</textarea>`:`<input type="${type}" name="${name}" value="${esc(value)}">`;return `<div class="field ${full?'full':''}"><label>${esc(label)}</label>${input}${help?`<span class="help">${esc(help)}</span>`:''}</div>`}
function formData(form){return Object.fromEntries(new FormData(form).entries())}
function nav(){ $('#nav').innerHTML=pages.map(p=>`<button class="${state.page===p[0]?'active':''}" onclick="go('${p[0]}')"><span class="icon">${p[1]}</span><span class="label">${p[2]}</span></button>`).join('') }
function go(page){state.page=page;location.hash=page;nav();$('#pageTitle').textContent=pages.find(p=>p[0]===page)?.[2]||page;loadPage()}
async function load(kind){return (state.cache[kind]=(await api('/api/resources/'+kind)).data)}
async function loadPage(){try{if(state.page==='dashboard')return dashboard();if(state.page==='chat')return chat();return resources(state.page)}catch(e){toast(e.message,true);$('#content').innerHTML=`<div class="empty">加载失败：${esc(e.message)}</div>`}}
async function dashboard(){let kinds=['agents','providers','skills','mcp_servers','knowledge','workflows'];let all=await Promise.all(kinds.map(load));let recent=await api('/api/threads');$('#content').innerHTML=`<div class="card hero"><h1>欢迎来到 Codezzn Workbench</h1><p>在一个地方组合模型、技能、知识与工具，将智能体变成可观察、可重复运行的工作流。</p></div><div class="grid">${[['智能体',all[0].length,'可运行配置'],['模型提供方',all[1].length,'OpenAI Compatible'],['技能',all[2].length,'可插拔指令'],['MCP 服务',all[3].length,'外部工具连接']].map(x=>`<div class="card metric"><span>${x[0]}</span><b>${x[1]}</b><span>${x[2]}</span></div>`).join('')}</div><div class="section-head" style="margin-top:25px"><div><h2>快速开始</h2><p>推荐按顺序完成平台配置</p></div></div><div class="resource-grid">${[['1','配置模型','填入 API Key 与可用模型','providers'],['2','插入能力','导入技能、知识文档或 MCP 工具','skills'],['3','组装智能体','选择模型与需要使用的能力','agents'],['4','对话或编排','调试智能体，再放入工作流','chat']].map(x=>`<div class="card resource"><div class="resource-title"><span class="badge">${x[0]}</span><strong>${x[1]}</strong></div><p>${x[2]}</p><div class="resource-actions"><button class="btn small" onclick="go('${x[3]}')">进入 →</button></div></div>`).join('')}</div><div class="section-head" style="margin-top:25px"><div><h2>最近对话</h2><p>${recent.data.length} 个活跃 Thread</p></div></div>${recent.data.length?`<div class="card">${recent.data.slice(0,6).map(t=>`<div class="thread" onclick="state.thread='${t.id}';go('chat')">${esc(t.name)} <span style="float:right">${esc(t.status)}</span></div>`).join('')}</div>`:`<div class="empty">还没有对话</div>`}`}
const labels={agents:['智能体','组合提示词、模型和工具能力'],providers:['模型接入','管理 OpenAI-compatible 推理端点'],skills:['技能','插入和选择 SKILL.md 指令包'],mcp_servers:['MCP 服务','连接标准化的外部工具与数据源'],knowledge:['知识库','上传文档并为智能体提供检索上下文'],workflows:['工作流','将智能体与工具编排成可重复 DAG']};
async function resources(kind){let list=await load(kind);$('#content').innerHTML=`<div class="section-head"><div><h2>${labels[kind][0]}</h2><p>${labels[kind][1]}</p></div><div>${kind==='skills'?`<button class="btn" onclick="importSkill()">导入 SKILL.md</button> `:''}<button class="btn primary" onclick="editResource('${kind}')">＋ 新建</button></div></div>${list.length?`<div class="resource-grid">${list.map(item=>resourceCard(kind,item)).join('')}</div>`:`<div class="empty">暂无${labels[kind][0]}，点击右上角新建。</div>`}`}
function resourceCard(kind,x){let desc=x.description||x.base_url||x.transport||`${(x.nodes||[]).length} 个节点`||'';let meta=kind==='agents'?`${x.model||'未选模型'} · ${(x.skill_ids||[]).length} 技能`:kind==='providers'?`${x.type==='bailian'?'阿里云百炼 · ':''}${(x.models||[]).length} models · ${x.api_key_configured?'密钥已配置':'未配置密钥'}`:kind==='knowledge'?'文档知识集合':kind==='mcp_servers'?(x.transport||'stdio').toUpperCase():kind==='workflows'?`${(x.nodes||[]).length} nodes`:'SKILL.md';return `<div class="card resource"><div class="resource-title"><span class="badge ${x.enabled?'':'off'}">${x.enabled?'启用':'停用'}</span><strong>${esc(x.name)}</strong></div><p>${esc(desc||'暂无描述')}</p><div class="help">${esc(meta)}</div><div class="resource-actions"><button class="btn small" onclick="editResource('${kind}','${x.id}')">编辑</button>${kind==='providers'?`<button class="btn small" onclick="testProvider('${x.id}')">测试连接</button>`:''}${kind==='knowledge'?`<button class="btn small" onclick="uploadDoc('${x.id}')">上传文档</button>`:''}${kind==='mcp_servers'?`<button class="btn small" onclick="testMcp('${x.id}')">测试</button>`:''}${kind==='workflows'?`<button class="btn small" onclick="runWorkflow('${x.id}')">运行</button>`:''}<button class="btn small danger" onclick="removeResource('${kind}','${x.id}')">删除</button></div></div>`}
async function editResource(kind,id){let x=id?state.cache[kind].find(v=>v.id===id):{};if(kind==='providers')return providerForm(x);if(kind==='skills')return skillForm(x);if(kind==='mcp_servers')return mcpForm(x);if(kind==='knowledge')return knowledgeForm(x);if(kind==='agents')return agentForm(x);if(kind==='workflows')return workflowForm(x)}
async function save(kind,id,data){try{await api('/api/resources/'+kind+(id?'/'+id:''),{method:id?'PUT':'POST',body:JSON.stringify(data)});closeModal();toast('已保存');loadPage()}catch(e){toast(e.message,true)}}
async function providerForm(x){let presets=(await api('/api/provider-presets')).data;let options=[`<option value="openai">OpenAI Compatible（自定义）</option>`,...presets.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`)].join('');modal(x.id?'编辑模型提供方':'新建模型提供方',`<form id="editForm" class="form-grid"><div class="field full"><label>快速预设</label><select name="preset">${options}</select><span class="help">百炼业务空间专属域名可在套用预设后，将域名替换为“业务空间ID.地域.maas.aliyuncs.com”，路径保持 /compatible-mode/v1。</span></div>${field('名称','name',x.name)}<div class="field"><label>类型</label><select name="type"><option value="openai" ${x.type!=='bailian'?'selected':''}>OpenAI Compatible</option><option value="bailian" ${x.type==='bailian'?'selected':''}>阿里云百炼 Qwen</option></select></div>${field('Base URL','base_url',x.base_url||'https://api.openai.com/v1','text',true)}${field('API Key','api_key','','password',true,x.api_key_configured?'密钥已配置。此处留空会保留原密钥；填写新值才会替换。':'请填写百炼 API Key。密钥与地域、计费方案必须匹配。')}${field('模型（逗号分隔）','models',(x.models||[]).join(', '),'text',true,'例如 qwen3.7-plus，不是 qwen-3.7plus。')}${field('默认模型','default_model',x.default_model||'gpt-4.1-mini')}${field('超时（秒）','timeout',x.timeout||120,'number')}</form>`,()=>{let d=formData($('#editForm'));delete d.preset;d.models=d.models.split(',').map(s=>s.trim()).filter(Boolean);d.timeout=Number(d.timeout);save('providers',x.id,d)});let f=$('#editForm');f.preset.onchange=()=>{let p=presets.find(v=>v.id===f.preset.value);if(!p)return;f.name.value=x.id?x.name:p.name;f.type.value=p.type;f.base_url.value=p.base_url;f.models.value=p.models.join(', ');f.default_model.value=p.default_model};}
function skillForm(x){modal(x.id?'编辑技能':'新建技能',`<form id="editForm" class="form-grid">${field('名称','name',x.name)}${field('描述','description',x.description)}${field('SKILL.md 内容','content',x.content||'# Skill\n\n描述智能体应遵循的工作步骤。','textarea',true)}<label class="check full"><input type="checkbox" name="enabled" ${x.enabled!==false?'checked':''}>启用技能</label></form>`,()=>{let d=formData($('#editForm'));d.enabled=$('#editForm [name=enabled]').checked;save('skills',x.id,d)})}
function mcpForm(x){modal(x.id?'编辑 MCP 服务':'新建 MCP 服务',`<form id="editForm" class="form-grid">${field('名称','name',x.name)}<div class="field"><label>Transport</label><select name="transport"><option value="stdio" ${x.transport!=='http'?'selected':''}>stdio</option><option value="http" ${x.transport==='http'?'selected':''}>HTTP JSON-RPC</option></select></div>${field('命令（stdio）','command',x.command||'npx','text',true)}${field('参数 JSON 数组','args',JSON.stringify(x.args||[]),'textarea',true)}${field('HTTP URL','url',x.url||'','text',true)}${field('环境变量 JSON','env',JSON.stringify(x.env||{}),'textarea')}${field('HTTP Headers JSON','headers',JSON.stringify(x.headers||{}),'textarea')}<label class="check full"><input type="checkbox" name="enabled" ${x.enabled!==false?'checked':''}>启用服务</label></form>`,()=>{try{let d=formData($('#editForm'));d.args=JSON.parse(d.args||'[]');d.env=JSON.parse(d.env||'{}');d.headers=JSON.parse(d.headers||'{}');d.enabled=$('#editForm [name=enabled]').checked;save('mcp_servers',x.id,d)}catch(e){toast('JSON 格式错误：'+e.message,true)}})}
function knowledgeForm(x){modal(x.id?'编辑知识库':'新建知识库',`<form id="editForm" class="form-grid">${field('名称','name',x.name)}${field('描述','description',x.description)}<label class="check full"><input type="checkbox" name="enabled" ${x.enabled!==false?'checked':''}>启用知识库</label></form>`,()=>{let d=formData($('#editForm'));d.enabled=$('#editForm [name=enabled]').checked;save('knowledge',x.id,d)})}
async function agentForm(x){let [providers,skills,kbs,mcps]=await Promise.all(['providers','skills','knowledge','mcp_servers'].map(load));let checks=(name,items,selected)=>items.map(i=>`<label class="check"><input type="checkbox" name="${name}" value="${i.id}" ${(selected||[]).includes(i.id)?'checked':''}>${esc(i.name)}</label>`).join('')||'<span class="help">暂无可选项</span>';modal(x.id?'编辑智能体':'新建智能体',`<form id="editForm" class="form-grid">${field('名称','name',x.name)}${field('描述','description',x.description)}<div class="field"><label>模型提供方</label><select name="provider_id">${providers.map(p=>`<option value="${p.id}" ${x.provider_id===p.id?'selected':''}>${esc(p.name)}</option>`).join('')}</select></div>${field('模型名称','model',x.model||providers[0]?.default_model||'')}${field('系统提示词','system_prompt',x.system_prompt||'你是一个可靠的智能体。','textarea',true)}${field('Temperature','temperature',x.temperature??0.2,'number')}${field('最大工具轮次','max_tool_rounds',x.max_tool_rounds||6,'number')}<div class="field full"><label>选择技能</label><div class="checkrow">${checks('skill_ids',skills,x.skill_ids)}</div></div><div class="field full"><label>选择知识库</label><div class="checkrow">${checks('knowledge_ids',kbs,x.knowledge_ids)}</div></div><div class="field full"><label>选择 MCP 服务</label><div class="checkrow">${checks('mcp_server_ids',mcps,x.mcp_server_ids)}</div></div><div class="field full"><label>内置工具</label><div class="checkrow">${checks('builtin_tools',[{id:'knowledge_search',name:'知识检索'},{id:'list_files',name:'列目录'},{id:'read_file',name:'读文件'},{id:'write_file',name:'写文件'},{id:'run_shell',name:'Shell'}],x.builtin_tools||[])}</div></div><label class="check"><input type="checkbox" name="allow_shell" ${x.allow_shell?'checked':''}>允许执行 Shell</label><label class="check"><input type="checkbox" name="enabled" ${x.enabled!==false?'checked':''}>启用智能体</label></form>`,()=>{let d=formData($('#editForm'));for(let n of ['skill_ids','knowledge_ids','mcp_server_ids','builtin_tools'])d[n]=[...$('#editForm').querySelectorAll(`[name=${n}]:checked`)].map(e=>e.value);d.temperature=Number(d.temperature);d.max_tool_rounds=Number(d.max_tool_rounds);d.allow_shell=$('#editForm [name=allow_shell]').checked;d.enabled=$('#editForm [name=enabled]').checked;save('agents',x.id,d)},true)}
function workflowForm(x){let sample={name:x.name||'文档问答流',description:x.description||'',enabled:x.enabled!==false,nodes:x.nodes||[{id:'input_1',type:'input'},{id:'agent_1',type:'agent',agent_id:'在此填智能体ID',prompt:'{{input}}'},{id:'output_1',type:'output',template:'{{last}}'}],edges:x.edges||[{source:'input_1',target:'agent_1'},{source:'agent_1',target:'output_1'}]};modal(x.id?'编辑工作流':'新建工作流',`<form id="editForm" class="form-grid">${field('名称','name',sample.name)}${field('描述','description',sample.description)}${field('工作流 JSON','definition',JSON.stringify({nodes:sample.nodes,edges:sample.edges},null,2),'textarea',true,'节点类型：input / prompt / agent / knowledge / mcp / output')}<label class="check full"><input type="checkbox" name="enabled" ${sample.enabled?'checked':''}>启用工作流</label></form>`,()=>{try{let d=formData($('#editForm')),def=JSON.parse(d.definition);save('workflows',x.id,{name:d.name,description:d.description,enabled:$('#editForm [name=enabled]').checked,nodes:def.nodes||[],edges:def.edges||[]})}catch(e){toast('JSON 格式错误：'+e.message,true)}},true);$('#editForm [name=definition]').style.minHeight='360px';$('#editForm [name=definition]').classList.add('codebox')}
async function removeResource(kind,id){if(!confirm('确定删除？此操作不可撤销。'))return;try{await api(`/api/resources/${kind}/${id}`,{method:'DELETE'});toast('已删除');loadPage()}catch(e){toast(e.message,true)}}
function importSkill(){modal('导入 SKILL.md',`<form id="uploadForm"><div class="field"><label>选择 Markdown 文件</label><input type="file" name="file" accept=".md,text/markdown" required></div></form>`,async()=>{try{let fd=new FormData($('#uploadForm'));await api('/api/skills/import',{method:'POST',body:fd});closeModal();toast('技能已导入');loadPage()}catch(e){toast(e.message,true)}})}
function uploadDoc(id){modal('上传知识文档',`<form id="uploadForm"><div class="field"><label>选择 TXT / MD / JSON / CSV / PDF</label><input type="file" name="file" required></div></form>`,async()=>{try{let fd=new FormData($('#uploadForm'));let r=await api(`/api/knowledge/${id}/documents`,{method:'POST',body:fd});closeModal();toast(`已生成 ${r.chunks} 个知识片段`)}catch(e){toast(e.message,true)}})}
async function testMcp(id){toast('正在连接 MCP…');try{let r=await api(`/api/mcp_servers/${id}/test`,{method:'POST'});modal('MCP 测试成功',`<p>发现 ${r.tools.length} 个工具：</p><pre class="codebox">${esc(JSON.stringify(r.tools,null,2))}</pre>`)}catch(e){toast(e.message,true)}}
async function testProvider(id){toast('正在请求模型…');try{let r=await api(`/api/providers/${id}/test`,{method:'POST',body:'{}'});modal('模型连接成功',`<div class="form-grid"><div class="field"><label>提供方</label><div>${esc(r.provider_type)}</div></div><div class="field"><label>模型</label><div>${esc(r.model)}</div></div><div class="field full"><label>兼容端点</label><div class="codebox">${esc(r.base_url)}</div></div><div class="field full"><label>模型响应</label><pre class="card codebox">${esc(r.response)}</pre></div></div>`)}catch(e){toast(e.message,true)}}
function runWorkflow(id){modal('运行工作流',`<form id="runForm">${field('输入','input','','textarea',true)}</form>`,async()=>{try{$('#modalSave').disabled=true;let r=await api(`/api/workflows/${id}/run`,{method:'POST',body:JSON.stringify({input:formData($('#runForm')).input})});modal(`运行${r.status==='completed'?'完成':'失败'}`,`<div class="field"><label>输出</label><pre class="card codebox">${esc(typeof r.output==='string'?r.output:JSON.stringify(r.output,null,2))}</pre></div><div class="run-trace"><b>节点 Trace</b>${r.trace.map(t=>`<div class="trace-item"><b>${esc(t.node_id)}</b> · ${esc(t.type)}<pre class="codebox">${esc(typeof t.output==='string'?t.output:JSON.stringify(t.output,null,2))}</pre></div>`).join('')}</div>`,null,true)}catch(e){toast(e.message,true)}})}
async function chat(){let [agents,threads]=await Promise.all([load('agents'),api('/api/threads')]);if(!state.thread&&threads.data[0])state.thread=threads.data[0].id;let current=state.thread?await api('/api/threads/'+state.thread).catch(()=>null):null;$('#content').innerHTML=`<div class="chat-layout"><aside class="thread-pane"><button class="btn primary" style="width:100%;margin-bottom:10px" onclick="newThread()">＋ 新对话</button>${threads.data.map(t=>`<div class="thread ${state.thread===t.id?'active':''}" onclick="state.thread='${t.id}';loadPage()">${esc(t.name)}<div class="help">${esc(t.status)}</div></div>`).join('')}</aside><div class="chat-main"><div class="messages" id="messages">${current?.messages?.length?current.messages.map(messageHtml).join(''):'<div class="empty">选择智能体并发送第一条消息。工具调用过程会记录在回复元数据中。</div>'}</div><div class="composer"><select id="chatAgent">${agents.map(a=>`<option value="${a.id}" ${(current?.agent_id===a.id)?'selected':''}>${esc(a.name)}</option>`).join('')}</select><textarea id="chatInput" placeholder="告诉 Codezzn 要完成什么…"></textarea><button class="btn primary" id="sendBtn" onclick="sendMessage()">发送</button></div></div></div>`;setTimeout(()=>{let m=$('#messages');if(m)m.scrollTop=m.scrollHeight},0)}
function messageHtml(m){let events=m.meta?.events||[];return `<div class="message ${m.role}"><div class="bubble"><div class="message-meta">${m.role==='user'?'你':'Codezzn'}</div>${esc(m.content)}${events.filter(e=>e.type.startsWith('tool_')).map(e=>`<div class="tool-event">${e.type==='tool_started'?'调用':'完成'} ${esc(e.name)}</div>`).join('')}</div></div>`}
async function newThread(){try{let agent=$('#chatAgent')?.value||(state.cache.agents||[])[0]?.id;let r=await api('/api/threads',{method:'POST',body:JSON.stringify({name:'新对话',agent_id:agent})});state.thread=r.id;loadPage()}catch(e){toast(e.message,true)}}
async function sendMessage(){let input=$('#chatInput'),content=input.value.trim(),agent=$('#chatAgent').value;if(!content)return;if(!state.thread)await newThread();input.value='';$('#sendBtn').disabled=true;$('#sendBtn').textContent='运行中…';try{await api(`/api/threads/${state.thread}/turns`,{method:'POST',body:JSON.stringify({content,agent_id:agent})});await loadPage()}catch(e){toast(e.message,true);await loadPage()}}
function openSettings(){modal('Workbench 设置',`<form id="settingsForm" class="form-grid">${field('X-Codezzn-Key','key',localStorage.codezznKey||'','password',true,'仅当服务端 CODEZZN_ADMIN_KEY 已设置时需要。')}</form>`,()=>{localStorage.codezznKey=formData($('#settingsForm')).key;closeModal();toast('设置已保存');loadPage()})}
async function checkHealth(){try{let r=await fetch('/healthz').then(r=>r.json());$('#healthText').textContent=`${r.name} 在线`}catch(e){$('#healthText').textContent='服务离线'}}
window.addEventListener('hashchange',()=>{let p=location.hash.slice(1);if(pages.some(x=>x[0]===p))go(p)});state.page=pages.some(x=>x[0]===location.hash.slice(1))?location.hash.slice(1):'dashboard';nav();$('#pageTitle').textContent=pages.find(p=>p[0]===state.page)[2];checkHealth();loadPage();
</script>
</body>
</html>
