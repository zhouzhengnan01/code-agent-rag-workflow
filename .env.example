CODEZZN_PORT=8080
CODEZZN_DATA_DIR=/app/data
# 设置后，除 /healthz 外所有 API 请求都需要 X-Codezzn-Key
CODEZZN_ADMIN_KEY=
# 浏览器工作台默认要求登录；docker-compose 默认开启。
CODEZZN_AUTH_REQUIRED=true
# 对外访问地址必须与 GitHub OAuth App 的 callback URL 一致：
# http://127.0.0.1:8080/api/auth/github/callback
CODEZZN_PUBLIC_URL=http://127.0.0.1:8080
CODEZZN_SESSION_DAYS=14
CODEZZN_COOKIE_SECURE=false
CODEZZN_GITHUB_CLIENT_ID=
CODEZZN_GITHUB_CLIENT_SECRET=
# Optional HTTP proxy reachable from the container, e.g. http://host.docker.internal:7897
CODEZZN_GITHUB_PROXY_URL=
# Google Auth Platform: OAuth client type "Web application".
# Local callback: http://127.0.0.1:8080/api/auth/google/callback
# Remote access requires an HTTPS DNS name; Google does not accept private LAN IP callbacks.
CODEZZN_GOOGLE_CLIENT_ID=
CODEZZN_GOOGLE_CLIENT_SECRET=
# Optional exact redirect URI; otherwise CODEZZN_PUBLIC_URL + /api/auth/google/callback.
CODEZZN_GOOGLE_REDIRECT_URI=
CODEZZN_GOOGLE_PROXY_URL=
# Continue with Email: use an SMTP authorization code/app password, not a mailbox login password.
# Supports any recipient domain; actual delivery depends on your SMTP relay and its policies.
CODEZZN_SMTP_HOST=
CODEZZN_SMTP_PORT=465
CODEZZN_SMTP_SECURITY=ssl
CODEZZN_SMTP_USER=
CODEZZN_SMTP_PASSWORD=
CODEZZN_SMTP_FROM=
# One-time migration of pre-isolation data; use the numeric GitHub ID, not a username.
CODEZZN_LEGACY_OWNER_GITHUB_ID=
# Docker 容器内允许智能体操作的根目录
CODEZZN_WORKSPACE=/workspace
CODEZZN_MILVUS_URI=/app/data/milvus.db
MILVUS_COLLECTION_PREFIX=codezzn_kb_
# 新建知识库的默认后端：local 或 ragflow。已有知识库不受此项影响。
CODEZZN_KNOWLEDGE_BACKEND=local
# RAGFlow 作为独立服务部署；地址可写 http://host:port 或 http://host:port/api/v1。
CODEZZN_RAGFLOW_URL=
CODEZZN_RAGFLOW_API_KEY=
CODEZZN_RAGFLOW_TIMEOUT=120
# 仅在默认 Docker Hub 镜像源不可用时覆盖，例如企业内部 Python 3.12 基础镜像
CODEZZN_BASE_IMAGE=python:3.12-slim
# Windows Docker Desktop bind mounts should keep the default 0:0.
# On Linux, set these to the owner of ./data and ./workspace.
CODEZZN_UID=0
CODEZZN_GID=0

# Shell/Git require the sandbox compose overlay; there is no host execution fallback.
# Generate a strong token and set a separate CODEZZN_ADMIN_KEY for status API access.
CODEZZN_SANDBOX_URL=http://sandbox-broker:8090
CODEZZN_SANDBOX_TOKEN=
CODEZZN_SANDBOX_IMAGE=codezzn-sandbox:local
CODEZZN_SANDBOX_INSTANCE=codezzn-local
CODEZZN_SANDBOX_CPUS=1
CODEZZN_SANDBOX_MEMORY_MB=512
CODEZZN_SANDBOX_PIDS=64
CODEZZN_SANDBOX_TIMEOUT=60
# 仅允许 git clone/fetch/push 的执行容器临时接入 bridge 网络；仍需工具审批。
CODEZZN_SANDBOX_GIT_NETWORK=true
# GitHub PR、Checks/Actions 与 Review comment API 使用；不要提交真实 Token。
CODEZZN_GITHUB_TOKEN=
# Broker-only settings are explicitly set in docker-compose.sandbox.yml, not forwarded from .env:
# CODEZZN_SANDBOX_BIND=0.0.0.0
# CODEZZN_SANDBOX_PORT=8090
# CODEZZN_SANDBOX_WORKSPACE_CONTAINER=codezzn
# CODEZZN_SANDBOX_STATE=/state/tasks.db

# 本地 Playwright 浏览器资源与网络边界。默认拒绝回环/局域网/链路本地目标；
# 配置私网访问时必须同时填写域名白名单并显式打开私网开关。
CODEZZN_BROWSER_ALLOWED_DOMAINS=
CODEZZN_BROWSER_ALLOW_PRIVATE_NETWORK=false
CODEZZN_BROWSER_MAX_SESSIONS=64
CODEZZN_BROWSER_MAX_TABS=12
CODEZZN_BROWSER_SESSION_IDLE_SECONDS=3600
CODEZZN_BROWSER_MAX_FILE_BYTES=52428800
