# Optional administrator-built Node + Python development image.
# Select it with CODEZZN_SANDBOX_IMAGE; requests cannot choose/pull images.
ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm
ARG NODE_IMAGE=node:22.20.0-bookworm-slim
FROM ${NODE_IMAGE} AS node
FROM ${PYTHON_IMAGE}
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
ARG INSTALL_LANGUAGE_SERVERS=false
ARG PYRIGHT_VERSION=1.1.390
ARG TYPESCRIPT_VERSION=5.7.2
ARG TYPESCRIPT_LANGUAGE_SERVER_VERSION=4.3.3
# Some networks/proxies return HTTP 502 on Debian's port-80 CDN while HTTPS
# succeeds. Keep the official repositories, suites and Signed-By unchanged.
RUN set -eu; \
    for source in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do \
        if [ -f "$source" ]; then \
            sed -i 's|http://deb.debian.org/|https://deb.debian.org/|g' "$source"; \
        fi; \
    done
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install -y --no-install-recommends git patch ripgrep ca-certificates libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --create-home sandbox \
    && mkdir -p /workspace && chown sandbox:sandbox /workspace
RUN if [ "$INSTALL_LANGUAGE_SERVERS" = "true" ]; then \
    npm install --global --ignore-scripts --no-audit --no-fund \
    pyright@${PYRIGHT_VERSION} typescript@${TYPESCRIPT_VERSION} typescript-language-server@${TYPESCRIPT_LANGUAGE_SERVER_VERSION}; fi
RUN python --version && node --version && npm --version \
    && if [ "$INSTALL_LANGUAGE_SERVERS" = "true" ]; then \
         pyright --version && tsc --version && typescript-language-server --version; \
       fi
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /workspace
CMD ["node", "--version"]
