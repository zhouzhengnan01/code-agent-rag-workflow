FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends git patch ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Default test tooling is Python's standard library; opt in at image build time.
ARG INSTALL_PYTEST=false
RUN if [ "$INSTALL_PYTEST" = "true" ]; then pip install --no-cache-dir pytest==8.3.5; fi
RUN groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --create-home sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace
USER 10001:10001
WORKDIR /workspace
CMD ["python", "--version"]
