CODEZZN_PORT=8080
CODEZZN_DATA_DIR=/app/data
# 设置后，除 /healthz 外所有 API 请求都需要 X-Codezzn-Key
CODEZZN_ADMIN_KEY=
# Docker 容器内允许智能体操作的根目录
CODEZZN_WORKSPACE=/workspace
CODEZZN_MILVUS_URI=/app/data/milvus.db
MILVUS_COLLECTION_PREFIX=codezzn_kb_
# 新建知识库的默认后端：local 或 ragflow。已有知识库不受此项影响。
CODEZZN_KNOWLEDGE_BACKEND=local
# RAGFlow 作为独立服务部署；地址可写 http://host:port 或 http://host:port/api/v1。
CODEZZN_RAGFLOW_URL=
CODEZZN_RAGFLOW_API_KEY=
CODEZZN_RAGFLOW_TIMEOUT=120
# 仅在默认 Docker Hub 镜像源不可用时覆盖，例如企业内部 Python 3.12 基础镜像
CODEZZN_BASE_IMAGE=python:3.12-slim
# Windows Docker Desktop bind mounts should keep the default 0:0.
# On Linux, set these to the owner of ./data and ./workspace.
CODEZZN_UID=0
CODEZZN_GID=0

# Shell/Git require the sandbox compose overlay; there is no host execution fallback.
# Generate a strong token and set a separate CODEZZN_ADMIN_KEY for status API access.
CODEZZN_SANDBOX_URL=http://sandbox-broker:8090
CODEZZN_SANDBOX_TOKEN=
CODEZZN_SANDBOX_IMAGE=codezzn-sandbox:local
CODEZZN_SANDBOX_INSTANCE=codezzn-local
CODEZZN_SANDBOX_CPUS=1
CODEZZN_SANDBOX_MEMORY_MB=512
CODEZZN_SANDBOX_PIDS=64
CODEZZN_SANDBOX_TIMEOUT=60
# 仅允许 git clone/fetch/push 的执行容器临时接入 bridge 网络；仍需工具审批。
CODEZZN_SANDBOX_GIT_NETWORK=true
# GitHub PR、Checks/Actions 与 Review comment API 使用；不要提交真实 Token。
CODEZZN_GITHUB_TOKEN=
# Broker-only settings are explicitly set in docker-compose.sandbox.yml, not forwarded from .env:
# CODEZZN_SANDBOX_BIND=0.0.0.0
# CODEZZN_SANDBOX_PORT=8090
# CODEZZN_SANDBOX_WORKSPACE_CONTAINER=codezzn
# CODEZZN_SANDBOX_STATE=/state/tasks.db
